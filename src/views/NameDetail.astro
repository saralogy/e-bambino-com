---
// NameDetail.astro — one baby name.
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Base.astro';
import ArticleHero from '../components/ArticleHero.astro';
import { getCollection, render } from 'astro:content';
import { SITE, UI, OTHER, path, sectionPath, entryLang, entrySlug, entryKey, dateFormat, type Lang } from '../i18n';

export interface Props {
  lang: Lang;
  entry: CollectionEntry<'namen'>;
}
const { lang, entry } = Astro.props;
const { Content } = await render(entry);

const COPY = {
  en: { crumb: 'Baby names', gender: 'Gender', origin: 'Origin', popularity: 'Popularity', asOf: 'Updated', girl: 'girl', boy: 'boy' },
  de: { crumb: 'Baby-Namen', gender: 'Geschlecht', origin: 'Herkunft', popularity: 'Beliebtheit', asOf: 'Stand', girl: 'Mädchen', boy: 'Jungen' },
}[lang];

const typLabel = { mädchen: COPY.girl, jungen: COPY.boy, girl: COPY.girl, boy: COPY.boy }[entry.data.typ ?? ''] ?? entry.data.typ;
const other = OTHER[lang];
const twin = (await getCollection('namen')).find((e) => entryLang(e) === other && entryKey(e) === entryKey(entry));
const alternates: Partial<Record<Lang, string>> = { [lang]: sectionPath(lang, 'names', entrySlug(entry))! };
if (twin) alternates[other] = sectionPath(other, 'names', entrySlug(twin))!;
const dtf = dateFormat(lang);

const pageUrl = `${SITE}${sectionPath(lang, 'names', entrySlug(entry))}`;
const sectionUrl = `${SITE}${sectionPath(lang, 'names')}`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: entry.data.title,
      description: entry.data.description,
      datePublished: entry.data.date.toISOString(),
      dateModified: (entry.data.updatedDate ?? entry.data.date).toISOString(),
      inLanguage: lang,
      author: { '@id': `${SITE}/#organization` },
      publisher: { '@id': `${SITE}/#organization` },
      mainEntityOfPage: pageUrl,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: UI[lang].home, item: `${SITE}${path(lang)}` },
        { '@type': 'ListItem', position: 2, name: COPY.crumb, item: sectionUrl },
        { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
      ],
    },
  ],
});
---

<Layout {lang} {alternates} title={entry.data.title} description={entry.data.description} type="article">
  <script type="application/ld+json" set:html={jsonLd} />
  <ArticleHero crumbs={[{ label: UI[lang].home, href: path(lang) }, { label: COPY.crumb, href: sectionPath(lang, 'names')! }, { label: entry.data.title }]}>
    <h1 class="font-display text-display-sm sm:text-display-md lg:text-display-lg text-balance break-words text-white">{entry.data.title}</h1>
    {entry.data.bedeutung && <p class="mt-4 font-display text-2xl font-bold text-limone">{entry.data.bedeutung}</p>}

    <dl class="mt-7 flex flex-wrap gap-2">
      {typLabel && <div><dt class="sr-only">{COPY.gender}</dt><dd class="chip-topic">{typLabel}</dd></div>}
      {entry.data.herkunft && <div><dt class="sr-only">{COPY.origin}</dt><dd class="chip-neutral">{entry.data.herkunft}</dd></div>}
      {entry.data.popularitaet && <div><dt class="sr-only">{COPY.popularity}</dt><dd class="chip-highlight">{entry.data.popularitaet}</dd></div>}
      <div>
        <dt class="sr-only">{COPY.asOf}</dt>
        <dd class="chip-neutral"><time datetime={entry.data.date.toISOString()}>{COPY.asOf} {dtf.format(entry.data.date)}</time></dd>
      </div>
    </dl>
  </ArticleHero>

  <article class="shell measure py-12 sm:py-16">
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>
