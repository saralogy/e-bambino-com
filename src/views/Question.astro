---
// Question.astro — one question page: answer-first card, body, related links, sibling questions.
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Base.astro';
import ArticleHero from '../components/ArticleHero.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { getCollection, render } from 'astro:content';
import { shipGate } from '../lib/shipgate';
import { hubBySlug } from '../i18n/hubs';
import { UI, OTHER, SITE, path, sectionPath, entryLang, entryKey, dateFormat, type Lang } from '../i18n';

export interface Props {
  lang: Lang;
  entry: CollectionEntry<'fragen'>;
}
const { lang, entry } = Astro.props;
const { Content } = await render(entry);

const COPY = {
  en: {
    short: 'Short answer',
    author: 'Author',
    reviewed: 'Reviewed by',
    updated: 'Updated',
    sources: 'Sources',
    seeSources: 'see sources',
    more: (hub: string) => `More questions about ${hub}`,
    asOf: 'Updated',
    types: { was: 'Basics', wie: 'How-to', 'ist-sind': 'Options & differences', kann: 'Safety & permissions', sonstiges: 'When, why & how much' } as Record<string, string>,
  },
  de: {
    short: 'Kurzantwort',
    author: 'Autor',
    reviewed: 'Geprüft von',
    updated: 'Aktualisiert am',
    sources: 'Quellen',
    seeSources: 'siehe Quellen',
    more: (hub: string) => `Weitere Fragen zu ${hub}`,
    asOf: 'Stand',
    types: { was: 'Was / Definition & Bedarf', wie: 'Wie / Anleitung', 'ist-sind': 'Ist / Sind / Merkmale & Optionen', kann: 'Kann / Erlaubnis & Sicherheit', sonstiges: 'Sonstiges / Warum, Wann, Wo, Wie viel' } as Record<string, string>,
  },
}[lang];

const hub = hubBySlug(lang, entry.data.hub);
const hubLabel = hub?.label ?? entry.data.hub;
const alle = (await getCollection('fragen')).filter((e) => shipGate(e.data).ship);
const siblings = alle
  .filter((e) => entryLang(e) === lang && e.data.hub === entry.data.hub && e.data.slug !== entry.data.slug)
  .slice(0, 5);

// Translation of this page, if it is published.
const other = OTHER[lang];
const twin = alle.find((e) => entryLang(e) === other && entryKey(e) === entryKey(entry));
const alternates: Partial<Record<Lang, string>> = { [lang]: path(lang, entry.data.hub, entry.data.slug) };
if (twin) alternates[other] = path(other, twin.data.hub, twin.data.slug);

const SOURCE_NAMES: Record<string, string> = {
  who: 'WHO', unece: 'UNECE', cpsc: 'CPSC', rki: 'RKI', awmf: 'AWMF',
  'kindergesundheit-info': 'kindergesundheit-info.de', verbraucherzentrale: 'Verbraucherzentrale',
};
const typLabel = COPY.types[entry.data.frageTyp] ?? entry.data.frageTyp;
const dtf = dateFormat(lang);
const updated = entry.data.updatedDate ?? entry.data.date;

const pageUrl = `${SITE}${path(lang, entry.data.hub, entry.data.slug)}`;
const orgId = `${SITE}/#organization`;
const reviewed = entry.data.ymyl && entry.data.reviewedBy ? entry.data.reviewedBy : null;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': orgId, name: 'e-bambino', url: SITE },
    {
      '@type': 'Article',
      headline: entry.data.frage,
      description: entry.data.description,
      datePublished: entry.data.date.toISOString(),
      dateModified: updated.toISOString(),
      inLanguage: lang,
      mainEntityOfPage: pageUrl,
      author: { '@id': orgId },
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: entry.data.frage,
      inLanguage: lang,
      mainEntity: {
        '@type': 'Question',
        name: entry.data.frage,
        text: entry.data.frage,
        answerCount: 1,
        acceptedAnswer: { '@type': 'Answer', text: entry.data.antwort, url: `${pageUrl}#answer` },
      },
      ...(reviewed ? { reviewedBy: { '@type': 'Person', name: reviewed }, lastReviewed: updated.toISOString() } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: UI[lang].home, item: `${SITE}${path(lang)}` },
        { '@type': 'ListItem', position: 2, name: hubLabel, item: `${SITE}${path(lang, entry.data.hub)}` },
        { '@type': 'ListItem', position: 3, name: entry.data.frage, item: `${SITE}${path(lang, entry.data.hub, entry.data.slug)}` },
      ],
    },
  ],
});
---

<Layout {lang} {alternates} title={entry.data.title} description={entry.data.description} type="article">
  <script type="application/ld+json" set:html={jsonLd} />

  <ArticleHero crumbs={[{ label: UI[lang].home, href: path(lang) }, { label: hubLabel, href: path(lang, entry.data.hub) }]}>
    <h1 class="display-2 text-balance">{entry.data.frage}</h1>
    <dl class="mt-6 flex flex-wrap items-center gap-2">
      <div>
        <dt class="sr-only">Type</dt>
        <dd class="chip-topic">{typLabel}</dd>
      </div>
      <div>
        <dt class="sr-only">{COPY.updated}</dt>
        <dd class="chip-neutral"><time datetime={updated.toISOString()}>{COPY.asOf} {dtf.format(updated)}</time></dd>
      </div>
    </dl>
  </ArticleHero>

  <article class="shell measure pb-12 sm:pb-16">
    <div id="answer" class="relative z-10 -mt-9 mb-10 rounded-ds-lg bg-ultramarine p-6 text-white shadow-lift sm:p-8">
      <p class="text-xs font-bold uppercase tracking-[0.08em] text-limone">{COPY.short}</p>
      <p class="mt-3 text-pretty text-lg leading-relaxed sm:text-xl">{entry.data.antwort}</p>
    </div>

    <div class="prose">
      <Content />
    </div>

    <p class="mt-12 border-t border-fog-100 pt-6 text-sm leading-relaxed text-night-500">
      {COPY.updated} {dtf.format(updated)}
      {entry.data.quellen?.length ? <> · {COPY.sources}: <a href={sectionPath(lang, 'sources')} class="text-ultramarine-700 underline underline-offset-2">{entry.data.quellen.map((k: string) => SOURCE_NAMES[k] ?? k).join(', ')}</a></> : null}
      {entry.data.ymyl && entry.data.reviewedBy ? <> · {`${COPY.reviewed} ${entry.data.reviewedBy}`}</> : null}
    </p>

    <RelatedLinks {lang} hub={entry.data.hub} {hubLabel} />

    {
      siblings.length > 0 && (
        <section class="mt-16 pt-10 border-t border-fog-100">
          <h2 class="text-xs font-bold uppercase tracking-[0.08em] text-night-500">{COPY.more(hubLabel)}</h2>
          <ul class="mt-5 divide-y divide-fog-100 border-y border-fog-100">
            {siblings.map((s) => (
              <li>
                <a href={path(lang, s.data.hub, s.data.slug)} class="group flex min-h-tap-m items-center justify-between gap-6 py-3 transition-colors duration-300">
                  <span class="font-medium text-night transition-colors duration-300 group-hover:text-ultramarine-700">{s.data.frage}</span>
                  <span class="shrink-0 text-ultramarine transition-transform duration-300 ease-smooth group-hover:translate-x-1" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Layout>
