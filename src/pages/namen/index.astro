---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getCollection } from 'astro:content';

// Static build: the query-string filter cannot be evaluated server-side, so all
// names ship in the HTML and filtering happens client-side (see script below).
const namen = (await getCollection('namen')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'));
---

<Layout
  title="Baby-Namen"
  description="Italienische Baby-Namen mit Bedeutung, Herkunft, Varianten und Beliebtheit in Deutschland, Österreich und der Schweiz."
>
  <section class="bg-wash">
    <div class="shell py-16 sm:py-20">
      <SectionHeader
        eyebrow="Mit Bedeutung und Herkunft"
        title="Italienische Baby-Namen"
        lede="Jeder Name mit Bedeutung, sprachlicher Herkunft und verlässlichen Varianten — geprüft und ohne Klickfarmen."
      />

      {/* Filter */}
      <div class="mt-10 flex flex-wrap items-center gap-2" role="group" aria-label="Namen nach Geschlecht filtern">
        <button
          type="button"
          data-filter="alle"
          class="fbtn rounded-pill border border-night bg-night px-5 py-2.5 text-sm font-medium text-white transition-all duration-300 ease-smooth"
          aria-pressed="true"
        >
          Alle
        </button>
        <button
          type="button"
          data-filter="mädchen"
          class="fbtn rounded-pill border border-fog-300 bg-white px-5 py-2.5 text-sm font-medium text-night-700 transition-all duration-300 ease-smooth hover:border-ultramarine"
          aria-pressed="false"
        >
          Mädchen
        </button>
        <button
          type="button"
          data-filter="jungen"
          class="fbtn rounded-pill border border-fog-300 bg-white px-5 py-2.5 text-sm font-medium text-night-700 transition-all duration-300 ease-smooth hover:border-ultramarine"
          aria-pressed="false"
        >
          Jungen
        </button>
        <p id="count" class="ml-1 text-sm text-night-500" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <section class="shell py-16 sm:py-20">
    <ul id="namen-list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        namen.map((n) => (
          <li data-typ={n.data.typ ?? ''}>
            <a href={`/namen/${n.slug}/`} class="card-link group flex h-full flex-col">
              <div class="flex items-baseline gap-3">
                <h2 class="font-display text-3xl font-semibold text-night transition-colors duration-300 group-hover:text-ultramarine-700">
                  {n.data.title}
                </h2>
              </div>
              {n.data.bedeutung && <p class="mt-2 font-medium text-ultramarine-700">{n.data.bedeutung}</p>}
              <p class="mt-3 flex-1 text-sm leading-relaxed text-night-500">{n.data.description}</p>
              <div class="mt-5 flex flex-wrap items-center gap-2">
                {n.data.typ && <span class="chip-blush">{n.data.typ}</span>}
                {n.data.herkunft && <span class="chip-mist">{n.data.herkunft}</span>}
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <p id="empty" class="hidden py-8 text-night-500">Hier ist noch kein Name eingetragen.</p>
  </section>
</Layout>

<script>
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.fbtn'));
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#namen-list > li'));
  const count = document.getElementById('count');
  const empty = document.getElementById('empty');

  function apply(filter: string) {
    let visible = 0;
    for (const li of items) {
      const match = filter === 'alle' || li.dataset.typ === filter;
      li.classList.toggle('hidden', !match);
      if (match) visible++;
    }
    if (count) count.textContent = `${visible} ${visible === 1 ? 'Name' : 'Namen'}`;
    empty?.classList.toggle('hidden', visible > 0);

    for (const b of btns) {
      const on = b.dataset.filter === filter;
      b.classList.toggle('bg-night', on);
      b.classList.toggle('text-white', on);
      b.classList.toggle('border-night', on);
      b.classList.toggle('bg-white', !on);
      b.classList.toggle('text-night-700', !on);
      b.classList.toggle('border-fog-300', !on);
      b.setAttribute('aria-pressed', String(on));
    }
  }

  for (const b of btns) {
    b.addEventListener('click', () => apply(b.dataset.filter ?? 'alle'));
  }

  // Read the filter from the URL on load so /namen/?typ=mädchen stays a shareable link.
  const initial = new URLSearchParams(location.search).get('typ');
  apply(initial === 'mädchen' || initial === 'jungen' ? initial : 'alle');
</script>