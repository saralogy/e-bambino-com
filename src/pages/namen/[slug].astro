---
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('namen');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'namen'> };
const { Content } = await render(entry);

const dtf = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
const isGirl = entry.data.typ === 'mädchen';
---

<Layout title={entry.data.title} description={entry.data.description} type="article">
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/namen/" class="hover:text-primary-600">Namen</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-gray-700">{entry.data.title}</span>
    </nav>

    <header class="mb-10">
      <div class="flex items-center gap-4">
        <span class="text-5xl" aria-hidden="true">{isGirl ? '👧' : '👦'}</span>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900">{entry.data.title}</h1>
      </div>
      {entry.data.bedeutung && <p class="mt-4 text-xl text-primary-700">{entry.data.bedeutung}</p>}

      <dl class="mt-6 flex flex-wrap gap-2 text-xs">
        {entry.data.typ && (
          <div><dt class="sr-only">Geschlecht</dt><dd class="rounded-full bg-primary-100 text-primary-800 px-3 py-1">{entry.data.typ}</dd></div>
        )}
        {entry.data.herkunft && (
          <div><dt class="sr-only">Herkunft</dt><dd class="rounded-full bg-gray-100 text-gray-700 px-3 py-1">{entry.data.herkunft}</dd></div>
        )}
        {entry.data.popularitaet && (
          <div><dt class="sr-only">Beliebtheit</dt><dd class="rounded-full bg-gray-100 text-gray-700 px-3 py-1">{entry.data.popularitaet}</dd></div>
        )}
        <div><dt class="sr-only">Stand</dt><dd class="rounded-full bg-gray-100 text-gray-500 px-3 py-1">Stand {dtf.format(entry.data.date)}</dd></div>
      </dl>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="mt-14 pt-8 border-t border-gray-200 text-sm text-gray-500">
      <p>
        Erstellt von {entry.data.author}. Geprüft nach den Regeln der e-bambino-Redaktion —
        menschliche Prüfung, Quellen offengelegt (EU AI Act Art. 50).
      </p>
    </footer>
  </article>
</Layout>