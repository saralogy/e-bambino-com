---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { TAXONOMY } from '../data/taxonomie';
import { shipGate } from '../lib/shipgate';

const [namen, checklisten, finanz, ratgeber, alleFragen] = await Promise.all([
  getCollection('namen'),
  getCollection('checklisten'),
  getCollection('finanz'),
  getCollection('ratgeber'),
  getCollection('fragen'),
]);

const fragen = alleFragen.filter((e) => shipGate(e.data).ship);

const hubs = TAXONOMY.map((h) => ({
  ...h,
  count: fragen.filter((f) => f.data.hub === h.slug).length,
}))
  .filter((h) => h.count > 0)
  .sort((a, b) => b.count - a.count);

const newest = [
  ...namen.map((e) => ({ title: e.data.title, href: `/namen/${e.slug}/`, kind: 'Name', date: e.data.date })),
  ...checklisten.map((e) => ({ title: e.data.title, href: `/checklisten/${e.slug}/`, kind: 'Checkliste', date: e.data.date })),
  ...finanz.map((e) => ({ title: e.data.title, href: `/finanz/${e.slug}/`, kind: 'Finanzen', date: e.data.date })),
  ...ratgeber.map((e) => ({ title: e.data.title, href: `/ratgeber/${e.slug}/`, kind: 'Ratgeber', date: e.data.date })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 5);

const fragenNeu = [...fragen]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const dtf = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });

const gesamtFragen = fragen.length;

const latestFrage = fragenNeu[0];
const featureCheckliste = [...checklisten].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const hubLabel = (slug: string) => TAXONOMY.find((t) => t.slug === slug)?.label ?? slug;

// DS color-block tiles. Full class strings so Tailwind sees them.
const tileStyles = [
  'bg-night text-white',
  'bg-ultramarine text-white',
  'bg-limone text-night',
  'bg-fog text-night',
];
---

<Layout>
  <!-- ============ Hero ============ -->
  <section class="relative overflow-hidden bg-ultramarine text-white">
    <div class="pointer-events-none absolute -right-24 -top-32 h-[28rem] w-[28rem] rounded-full bg-ultramarine-700 sm:h-[38rem] sm:w-[38rem]" aria-hidden="true"></div>
    <div class="shell relative py-16 sm:py-24 lg:py-28">
      <div class="flex flex-wrap items-center gap-x-16 gap-y-14">
        <div class="min-w-0 flex-[1_1_30rem]">
          <p class="eyebrow !text-limone rise">
            <span class="inline-block h-0.5 w-8 bg-limone" aria-hidden="true"></span>
            Italienisch · Deutsch · DACH
          </p>

          <h1 class="display-1 mt-6 !text-white text-balance rise rise-delay-1">
            Der italienische Familienratgeber für <span class="whitespace-nowrap text-limone">DACH &amp; EU</span>
          </h1>

          <p class="lede measure mt-7 !text-ultramarine-100 text-pretty rise rise-delay-2">
            Namen, Checklisten und finanzielle Hilfen für die ersten Jahre mit einem Kind —
            verständlich erklärt, von Menschen geprüft, ohne Werbung und ohne Fachchinesisch.
          </p>

          <form action="/fragen/" method="get" role="search" class="mt-9 flex max-w-xl items-center gap-2 rounded-pill bg-white p-1.5 pl-5 text-night shadow-lift focus-within:ring-[3px] focus-within:ring-limone rise rise-delay-3">
            <svg class="h-5 w-5 shrink-0 text-night-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M16.5 16.5L21 21"></path></svg>
            <label for="hero-q" class="sr-only">Frage suchen</label>
            <input id="hero-q" name="q" type="search" autocomplete="off" placeholder="z. B. Hochstuhl, Wickeln, Elterngeld" class="min-h-tap-s min-w-0 flex-1 bg-transparent text-base text-night outline-none placeholder:text-night-500" />
            <button type="submit" class="btn-primary !min-h-tap-s !rounded-pill !px-6">Suchen</button>
          </form>

          <ul class="mt-6 flex flex-wrap gap-2.5 rise rise-delay-3" aria-label="Direkt zu">
            <li><a href="/namen/" class="inline-flex min-h-tap-s items-center rounded-pill border-2 border-white/60 px-5 text-sm font-bold text-white transition-colors duration-tap hover:border-limone hover:text-limone">Namen</a></li>
            <li><a href="/checklisten/" class="inline-flex min-h-tap-s items-center rounded-pill border-2 border-white/60 px-5 text-sm font-bold text-white transition-colors duration-tap hover:border-limone hover:text-limone">Checklisten</a></li>
            <li><a href="/finanz/" class="inline-flex min-h-tap-s items-center rounded-pill border-2 border-white/60 px-5 text-sm font-bold text-white transition-colors duration-tap hover:border-limone hover:text-limone">Finanzielle Hilfen</a></li>
            <li><a href="/ratgeber/" class="inline-flex min-h-tap-s items-center rounded-pill border-2 border-white/60 px-5 text-sm font-bold text-white transition-colors duration-tap hover:border-limone hover:text-limone">Ratgeber</a></li>
          </ul>

          <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-4 border-t border-white/25 pt-8">
            <div>
              <dt class="font-display text-2xl font-extrabold text-white">{gesamtFragen}</dt>
              <dd class="text-sm text-ultramarine-100">beantwortete Fragen</dd>
            </div>
            <div>
              <dt class="font-display text-2xl font-extrabold text-white">{hubs.length}</dt>
              <dd class="text-sm text-ultramarine-100">Themenbereiche</dd>
            </div>
            <div>
              <dt class="font-display text-2xl font-extrabold text-white">0</dt>
              <dd class="text-sm text-ultramarine-100">Werbeanzeigen</dd>
            </div>
          </dl>
        </div>

        {
          (latestFrage || featureCheckliste) && (
            <div class="relative mx-auto flex w-full max-w-sm flex-[1_1_18rem] flex-col gap-5 sm:max-w-md lg:mx-0" aria-label="Aktuell">
              <div class="pointer-events-none absolute -right-4 -top-6 hidden h-14 w-40 rounded-pill bg-limone lg:block" aria-hidden="true"></div>
              <div class="pointer-events-none absolute -bottom-6 left-2 hidden h-20 w-20 rounded-full bg-mandarin lg:block" aria-hidden="true"></div>
              {latestFrage && (
                <a href={`/${latestFrage.data.hub}/${latestFrage.data.slug}/`} class="relative block rounded-ds-lg bg-white p-6 text-night shadow-lift transition-transform duration-lift ease-reveal hover:-translate-y-1 lg:-rotate-2">
                  <span class="chip-blush">{hubLabel(latestFrage.data.hub)}</span>
                  <span class="mt-4 block font-display text-xl font-bold leading-snug tracking-tight text-pretty">{latestFrage.data.frage}</span>
                  <span class="mt-4 block text-sm font-bold text-ultramarine-700">Antwort lesen →</span>
                </a>
              )}
              {featureCheckliste && (
                <a href={`/checklisten/${featureCheckliste.slug}/`} class="relative block rounded-ds-lg bg-night p-6 text-white shadow-lift transition-transform duration-lift ease-reveal hover:-translate-y-1 lg:ml-10 lg:rotate-2">
                  <span class="text-xs font-bold uppercase tracking-[0.08em] text-limone">Checkliste</span>
                  <span class="mt-3 block font-display text-xl font-bold leading-snug tracking-tight text-pretty">{featureCheckliste.data.title}</span>
                  <span class="mt-4 block text-sm font-bold text-limone">Zum Abhaken →</span>
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ============ Trust strip ============ -->
  <section class="border-b border-fog-100 bg-white">
    <div class="shell py-7">
      <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { t: 'Von Menschen geprüft', d: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z M8.5 12l2.5 2.5 5-5' },
            { t: 'Quellen offengelegt', d: 'M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M15.5 8.5l-2 5-5 2 2-5z' },
            { t: 'Mit Stand-Datum', d: 'M3 12V4h8l10 10-8 8L3 12z M7 8.2a1 1 0 1 0 2 0a1 1 0 1 0 -2 0' },
            { t: 'EU AI Act Art. 50', d: 'M5 12.5l4.5 4.5L19 7.5' },
          ].map((x) => (
            <li class="flex items-center gap-3 text-base font-semibold text-night">
              <svg class="h-7 w-7 shrink-0 text-ultramarine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={x.d}></path></svg>
              {x.t}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Themenbereiche (color-block tiles) ============ -->
  <section class="shell py-20 sm:py-24">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <h2 class="display-2 text-balance">Wonach suchst du?</h2>
      <a href="/fragen/" class="inline-flex min-h-tap-s items-center text-base font-bold text-ultramarine-700 hover:text-ultramarine">Alle Themen →</a>
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        hubs.map((h, i) => (
          <li>
            <a
              href={`/${h.slug}/`}
              class:list={[
                'group flex h-full min-h-[12rem] flex-col justify-between gap-8 rounded-ds-lg p-6 transition-transform duration-lift ease-reveal hover:-translate-y-1',
                tileStyles[i % tileStyles.length],
              ]}
            >
              <span class="font-display text-2xl font-bold leading-tight tracking-tight text-pretty">{h.label}</span>
              <span class="flex items-center justify-between text-sm font-bold">
                <span>{h.count} {h.count === 1 ? 'Frage' : 'Fragen'}</span>
                <span class="text-xl transition-transform duration-lift ease-reveal group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ Zuletzt beantwortet ============ -->
  {
    fragenNeu.length > 0 && (
      <section class="bg-fog py-20 sm:py-24">
        <div class="shell">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow">Zuletzt ergänzt</p>
              <h2 class="display-2 mt-3">Neue Antworten</h2>
            </div>
            <a href="/fragen/" class="inline-flex min-h-tap-s items-center text-base font-bold text-ultramarine-700 hover:text-ultramarine">
              Alle {gesamtFragen} Fragen →
            </a>
          </div>

          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {fragenNeu.map((e) => (
              <a href={`/${e.data.hub}/${e.data.slug}/`} class="card-link group flex flex-col">
                <span class="chip-blush self-start">{TAXONOMY.find((t) => t.slug === e.data.hub)?.label ?? e.data.hub}</span>
                <h3 class="mt-4 font-display text-lg font-semibold leading-snug text-night transition-colors duration-300 group-hover:text-ultramarine-700 text-pretty">
                  {e.data.frage}
                </h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-night-500 line-clamp-3">
                  {e.data.antwort.slice(0, 130)}…
                </p>
                <time
                  datetime={e.data.date.toISOString()}
                  class="mt-5 text-xs uppercase tracking-wider text-night-500"
                >
                  {dtf.format(e.data.date)}
                </time>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ Selbst erledigen ============ -->
  <section class="shell py-20 sm:py-24">
    <div class="rounded-[1.75rem] bg-night p-8 text-white sm:p-12">
      <div class="flex flex-wrap gap-x-14 gap-y-10">
        <div class="flex-[1_1_20rem]">
          <p class="eyebrow !text-limone">
            <span class="inline-block h-0.5 w-8 bg-limone" aria-hidden="true"></span>
            Selbst erledigen
          </p>
          <h2 class="display-2 mt-4 !text-white text-balance">Weniger Papierkram, mehr Zeit fürs Baby</h2>
          <p class="mt-5 text-lg leading-relaxed text-fog-300 text-pretty">
            Checklisten, Namen und Hilfen zum direkten Nutzen. Kostenlos und ohne Anmeldung.
          </p>
        </div>
        <ul class="grid flex-[2_1_26rem] gap-4 sm:grid-cols-2">
          {
            [
              { kicker: 'Checklisten', title: 'Kliniktasche und Reise', blurb: 'Zum Abhaken statt zum Nachschlagen.', href: '/checklisten/' },
              { kicker: 'Finanzen', title: 'Elterngeld und Kindergeld', blurb: 'Beträge, Fristen und Unterlagen.', href: '/finanz/' },
              { kicker: 'Baby-Namen', title: 'Italienische Namen', blurb: 'Mit Bedeutung und Herkunft.', href: '/namen/' },
              { kicker: 'Ratgeber', title: 'Schlaf und Entwicklung', blurb: 'Mit Quellen und Stand-Datum.', href: '/ratgeber/' },
            ].map((p) => (
              <li>
                <a href={p.href} class="group flex h-full flex-col rounded-ds-md bg-white p-5 text-night transition-transform duration-lift ease-reveal hover:-translate-y-1">
                  <span class="text-xs font-bold uppercase tracking-[0.08em] text-ultramarine">{p.kicker}</span>
                  <span class="mt-2 font-display text-xl font-bold leading-snug tracking-tight">{p.title}</span>
                  <span class="mt-1 flex-1 text-sm leading-relaxed text-night-500">{p.blurb}</span>
                  <span class="mt-4 text-sm font-bold text-ultramarine-700">Öffnen →</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      newest.length > 0 && (
        <div class="mt-14">
          <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-night-500">Zuletzt aktualisiert</h3>
          <ul class="mt-5 divide-y divide-fog-100 border-y border-fog-100">
            {newest.map((n) => (
              <li>
                <a
                  href={n.href}
                  class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4 transition-colors duration-300"
                >
                  <span class="font-medium text-night transition-colors duration-300 group-hover:text-ultramarine-700">
                    {n.title}
                  </span>
                  <span class="text-xs uppercase tracking-wider text-night-500">
                    {n.kind} · <time datetime={n.date.toISOString()}>{dtf.format(n.date)}</time>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <!-- ============ CTA ============ -->
  <section class="bg-ultra-deep text-white">
    <div class="shell py-20 sm:py-24">
      <div class="max-w-2xl">
        <p class="eyebrow !text-limone">Ihr Baby bekommt einen Namen</p>
        <h2 class="font-display mt-4 text-3xl leading-tight sm:text-4xl text-balance">
          Wir helfen beim Finden — und beim Vorbereiten auf alles, was kommt.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-fog-100 text-pretty">
          Stöbern Sie durch italienische Namen mit echter Bedeutung, oder holen Sie sich die
          Checkliste für die Klinik. Kostenlos, ohne Anmeldung.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/namen/" class="btn bg-limone text-night hover:bg-limone-300">Zu den Namen</a>
          <a
            href="/fragen/"
            class="btn bg-white/10 text-white border border-white/25 hover:bg-white/20 hover:-translate-y-0.5 transition-all duration-300 ease-smooth"
          >
            Alle Fragen
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>