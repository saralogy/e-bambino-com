---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { TAXONOMY } from '../data/taxonomie';
import { shipGate } from '../lib/shipgate';

const [namen, checklisten, finanz, ratgeber, alleFragen] = await Promise.all([
  getCollection('namen'),
  getCollection('checklisten'),
  getCollection('finanz'),
  getCollection('ratgeber'),
  getCollection('fragen'),
]);

const fragen = alleFragen.filter((e) => shipGate(e.data).ship);

const hubs = TAXONOMY.map((h) => ({
  ...h,
  count: fragen.filter((f) => f.data.hub === h.slug).length,
}))
  .filter((h) => h.count > 0)
  .sort((a, b) => b.count - a.count);

const newest = [
  ...namen.map((e) => ({ title: e.data.title, href: `/namen/${e.slug}/`, kind: 'Name', date: e.data.date })),
  ...checklisten.map((e) => ({ title: e.data.title, href: `/checklisten/${e.slug}/`, kind: 'Checkliste', date: e.data.date })),
  ...finanz.map((e) => ({ title: e.data.title, href: `/finanz/${e.slug}/`, kind: 'Finanzen', date: e.data.date })),
  ...ratgeber.map((e) => ({ title: e.data.title, href: `/ratgeber/${e.slug}/`, kind: 'Ratgeber', date: e.data.date })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 5);

const fragenNeu = [...fragen]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const dtf = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });

const gesamtFragen = fragen.length;
---

<Layout>
  <!-- ============ Hero ============ -->
  <section class="relative overflow-hidden bg-ultramarine text-white">
    <div class="pointer-events-none absolute -right-24 -top-32 h-[28rem] w-[28rem] rounded-full bg-ultramarine-700 sm:h-[36rem] sm:w-[36rem]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute bottom-12 right-10 hidden h-14 w-44 rounded-pill bg-limone lg:block" aria-hidden="true"></div>
    <div class="pointer-events-none absolute bottom-40 right-56 hidden h-24 w-24 rounded-full bg-mandarin lg:block" aria-hidden="true"></div>
    <div class="shell relative py-20 sm:py-28 lg:py-32">
      <div class="max-w-3xl">
        <p class="eyebrow !text-limone rise">
          <span class="inline-block h-0.5 w-8 bg-limone" aria-hidden="true"></span>
          Italienisch · Deutsch · DACH
        </p>

        <h1 class="display-1 mt-6 !text-white text-balance rise rise-delay-1">
          Der italienische<br class="hidden sm:block" />
          Familienratgeber für <span class="whitespace-nowrap text-limone">DACH &amp; EU</span>
        </h1>

        <p class="lede measure mt-7 !text-ultramarine-100 text-pretty rise rise-delay-2">
          Namen, Checklisten und finanzielle Hilfen für die ersten Jahre mit einem Kind —
          verständlich erklärt, von Menschen geprüft, ohne Werbung und ohne Fachchinesisch.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row rise rise-delay-3">
          <a href="/fragen/" class="btn bg-white text-night hover:bg-limone">Fragen durchsuchen</a>
          <a href="/namen/" class="btn border-2 border-white text-white hover:bg-white/10">Namen entdecken</a>
        </div>

        <dl class="mt-12 flex flex-wrap gap-x-8 gap-y-4 border-t border-white/25 pt-8">
          <div>
            <dt class="font-display text-2xl font-semibold text-white">{gesamtFragen}</dt>
            <dd class="text-sm text-ultramarine-100">beantwortete Fragen</dd>
          </div>
          <div>
            <dt class="font-display text-2xl font-semibold text-white">{hubs.length}</dt>
            <dd class="text-sm text-ultramarine-100">Themenbereiche</dd>
          </div>
          <div>
            <dt class="font-display text-2xl font-semibold text-white">0</dt>
            <dd class="text-sm text-ultramarine-100">Werbeanzeigen</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ Trust strip ============ -->
  <section class="border-y border-fog-100 bg-white">
    <div class="shell py-6">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-sm text-night-500">
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-ultramarine" aria-hidden="true"></span>
          Von Menschen geprüft
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-ultramarine-700" aria-hidden="true"></span>
          Quellen offengelegt
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-fog-300" aria-hidden="true"></span>
          Mit Stand-Datum
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-night" aria-hidden="true"></span>
          EU AI Act Art. 50
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ Themenbereiche (editorial list, not boxes) ============ -->
  <section class="shell py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="display-2 text-balance">Themen&shy;bereiche</h2>
        <p class="lede mt-5 text-pretty">
          Keine Definitionssammlung, sondern Antworten auf die Fragen, die Eltern tatsächlich
          stellen — gruppiert nach dem, was Sie gerade beschäftigt.
        </p>
        <div class="rule-gradient mt-8 w-32" aria-hidden="true"></div>
      </div>

      <div class="lg:col-span-8">
        <ul class="divide-y divide-fog-100 border-y border-fog-100">
          {
            hubs.map((h) => (
              <li>
                <a
                  href={`/${h.slug}/`}
                  class="group flex flex-col gap-2 py-6 transition-colors duration-300 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
                >
                  <span class="flex-1">
                    <span class="font-display text-xl font-semibold text-night transition-colors duration-300 group-hover:text-ultramarine-700 sm:text-2xl">
                      {h.label}
                    </span>
                    <span class="mt-2 block max-w-xl text-pretty text-sm leading-relaxed text-night-500">
                      {h.answer.slice(0, 120)}…
                    </span>
                  </span>
                  <span class="flex shrink-0 items-center gap-3 text-sm text-night-500">
                    <span class="chip-mist">{h.count} Fragen</span>
                    <span
                      class="text-ultramarine transition-transform duration-300 ease-smooth group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ Zuletzt beantwortet ============ -->
  {
    fragenNeu.length > 0 && (
      <section class="bg-fog py-20 sm:py-24">
        <div class="shell">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow">Zuletzt ergänzt</p>
              <h2 class="display-2 mt-3">Neue Antworten</h2>
            </div>
            <a href="/fragen/" class="inline-flex min-h-tap-s items-center text-base font-bold text-ultramarine-700 hover:text-ultramarine">
              Alle {gesamtFragen} Fragen →
            </a>
          </div>

          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {fragenNeu.map((e) => (
              <a href={`/${e.data.hub}/${e.data.slug}/`} class="card-link group flex flex-col">
                <span class="chip-blush self-start">{TAXONOMY.find((t) => t.slug === e.data.hub)?.label ?? e.data.hub}</span>
                <h3 class="mt-4 font-display text-lg font-semibold leading-snug text-night transition-colors duration-300 group-hover:text-ultramarine-700 text-pretty">
                  {e.data.frage}
                </h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-night-500 line-clamp-3">
                  {e.data.antwort.slice(0, 130)}…
                </p>
                <time
                  datetime={e.data.date.toISOString()}
                  class="mt-5 text-xs uppercase tracking-wider text-night-500"
                >
                  {dtf.format(e.data.date)}
                </time>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ Weitere Bereiche ============ -->
  <section class="shell py-20 sm:py-24">
    <h2 class="display-2">Weitere Bereiche</h2>
    <p class="lede measure mt-4 text-pretty">
      Neben den Fragen gibt es Werkzeuge, die Sie im Alltag brauchen.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          { title: 'Baby-Namen', href: '/namen/', blurb: 'Italienische Namen mit Bedeutung und Herkunft.' },
          { title: 'Checklisten', href: '/checklisten/', blurb: 'Kliniktasche und Reise — zum Abhaken.' },
          { title: 'Finanzielle Hilfen', href: '/finanz/', blurb: 'Elterngeld und Kindergeld mit Fristen.' },
          { title: 'Ratgeber', href: '/ratgeber/', blurb: 'Schlaf und Entwicklung mit Quellen.' },
        ].map((p) => (
          <a href={p.href} class="card-link group">
            <h3 class="font-display text-lg font-semibold text-night transition-colors duration-300 group-hover:text-ultramarine-700">
              {p.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-night-500">{p.blurb}</p>
          </a>
        ))
      }
    </div>

    {
      newest.length > 0 && (
        <div class="mt-14">
          <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-night-500">Zuletzt aktualisiert</h3>
          <ul class="mt-5 divide-y divide-fog-100 border-y border-fog-100">
            {newest.map((n) => (
              <li>
                <a
                  href={n.href}
                  class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4 transition-colors duration-300"
                >
                  <span class="font-medium text-night transition-colors duration-300 group-hover:text-ultramarine-700">
                    {n.title}
                  </span>
                  <span class="text-xs uppercase tracking-wider text-night-500">
                    {n.kind} · <time datetime={n.date.toISOString()}>{dtf.format(n.date)}</time>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <!-- ============ CTA ============ -->
  <section class="bg-ultra-deep text-white">
    <div class="shell py-20 sm:py-24">
      <div class="max-w-2xl">
        <p class="eyebrow !text-limone">Ihr Baby bekommt einen Namen</p>
        <h2 class="font-display mt-4 text-3xl leading-tight sm:text-4xl text-balance">
          Wir helfen beim Finden — und beim Vorbereiten auf alles, was kommt.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-fog-100 text-pretty">
          Stöbern Sie durch italienische Namen mit echter Bedeutung, oder holen Sie sich die
          Checkliste für die Klinik. Kostenlos, ohne Anmeldung.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/namen/" class="btn bg-limone text-night hover:bg-limone-300">Zu den Namen</a>
          <a
            href="/fragen/"
            class="btn bg-white/10 text-white border border-white/25 hover:bg-white/20 hover:-translate-y-0.5 transition-all duration-300 ease-smooth"
          >
            Alle Fragen
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>