---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getCollection } from 'astro:content';

const finanz = await getCollection('finanz');
const dtf = new Intl.DateTimeFormat('de-DE', { month: 'long', year: 'numeric' });
---

<Layout
  title="Finanzielle Hilfen"
  description="Elterngeld, Kindergeld und weitere finanzielle Unterstützung für Familien — mit Beträgen, Fristen und Antragsunterlagen."
>
  <section class="bg-wash">
    <div class="shell py-16 sm:py-20">
      <SectionHeader
        eyebrow="Mit Stand-Datum"
        title="Finanzielle Hilfen"
        lede="Elterngeld, Kindergeld und weitere Unterstützung für Familien — mit Beträgen, Fristen und den Unterlagen für den Antrag. Beträge können sich ändern; maßgeblich ist die Auskunft der zuständigen Stelle."
      />
    </div>
  </section>

  <section class="shell py-16 sm:py-20">
    {
      finanz.length === 0 ? (
        <p class="text-night-500">Hier werden in den nächsten Tagen weitere Hilfen ergänzt.</p>
      ) : (
        <ul class="divide-y divide-fog-100 border-y border-fog-100">
          {finanz.map((f) => (
            <li>
              <a
                href={`/finanz/${f.slug}/`}
                class="group flex flex-col gap-2 py-6 transition-colors duration-300 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
              >
                <span class="flex-1">
                  <span class="font-display text-xl font-semibold text-night transition-colors duration-300 group-hover:text-ultramarine-700 sm:text-2xl">
                    {f.data.title}
                  </span>
                  <span class="mt-2 block max-w-xl text-pretty text-sm leading-relaxed text-night-500">
                    {f.data.description}
                  </span>
                </span>
                <span class="flex shrink-0 items-center gap-3 text-sm text-night-500">
                  <time class="text-xs uppercase tracking-wider text-night-500" datetime={f.data.date.toISOString()}>
                    Stand {dtf.format(f.data.date)}
                  </time>
                  <span
                    class="text-ultramarine transition-transform duration-300 ease-smooth group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <aside class="mt-12 rounded-card border border-ultramarine-100 bg-ultramarine-50 p-6">
      <h2 class="font-display text-lg font-semibold text-night">Verbindlich ist die Behörde</h2>
      <p class="mt-2 text-sm leading-relaxed text-night-700">
        Diese Seiten sind eine Orientierung, keine Rechts- oder Steuerberatung. Beträge und Fristen können
        sich ändern — lassen Sie sich den aktuellen Stand bei der zuständigen Stelle bestätigen.
      </p>
    </aside>
  </section>
</Layout>