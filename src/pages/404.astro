---
import Layout from '../layouts/Base.astro';

const bereiche = [
  { label: 'Alle Fragen', href: '/fragen/' },
  { label: 'Baby-Namen', href: '/namen/' },
  { label: 'Checklisten', href: '/checklisten/' },
  { label: 'Finanzielle Hilfen', href: '/finanz/' },
  { label: 'Ratgeber', href: '/ratgeber/' },
];
---

<Layout title="404 — Seite nicht gefunden" description="Diese Seite existiert nicht (404)." noindex>
  <section class="bg-wash">
    <div class="shell py-24 text-center sm:py-32">
      <p class="font-display text-display-lg font-semibold text-ultramarine-100" aria-hidden="true">404</p>
      <h1 class="display-2 mt-4 text-balance">Diese Seite gibt es nicht</h1>
      <p class="lede mx-auto mt-5 max-w-xl text-pretty">
        Möglicherweise wurde sie verschoben oder entfernt. Diese Bereiche gibt es:
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {
          bereiche.map((b, i) => (
            <a href={b.href} class={i === 0 ? 'btn-primary' : 'btn-secondary'}>
              {b.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>