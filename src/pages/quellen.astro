---
import Layout from '../layouts/Layout.astro';

const quellen = [
  {
    org: 'AWMF',
    voll: 'Arbeitsgemeinschaft der Wissenschaftlichen Medizinischen Fachgesellschaften',
    url: 'https://register.awmf.org',
    fuer: 'Medizinische Leitlinien, Schwangerschaft, Säuglingspflege, Ernährung',
  },
  {
    org: 'RKI',
    voll: 'Robert Koch-Institut',
    url: 'https://www.rki.de',
    fuer: 'Infektionskrankheiten, Impfempfehlungen, Gesundheitsberichterstattung',
  },
  {
    org: 'BMFSFJ',
    voll: 'Bundesministerium für Familie, Senioren, Frauen und Jugend',
    url: 'https://www.bmfsfj.de',
    fuer: 'Elterngeld, Kindergeld, Familienleistungen, gesetzliche Grundlagen',
  },
  {
    org: 'Destatis',
    voll: 'Statistisches Bundesamt',
    url: 'https://www.destatis.de',
    fuer: 'Namensstatistik, Geburten, Bevölkerungsentwicklung',
  },
  {
    org: 'Statistik Austria',
    voll: 'Statistik Austria — Bundesamt für Statistik',
    url: 'https://www.statistik.at',
    fuer: 'Namensvergabe und Bevölkerungsstatistik Österreich',
  },
  {
    org: 'BFS',
    voll: 'Bundesamt für Statistik — Schweiz',
    url: 'https://www.bfs.admin.ch',
    fuer: 'Namensstatistik und Bevölkerungsdaten Schweiz',
  },
  {
    org: 'Deutsche Rentenversicherung',
    voll: 'Deutsche Rentenversicherung',
    url: 'https://www.deutsche-rentenversicherung.de',
    fuer: 'Sozialleistungen, Kinderzuschlag, Familienversicherung',
  },
  {
    org: 'Istat',
    voll: 'Instituto Nazionale di Statistica (Italien)',
    url: 'https://www.istat.it',
    fuer: 'Namensstatistik Italien, als Referenz für den italienischen Namensraum',
  },
];
---

<Layout
  title="Quellen"
  description="Die vollständige Liste der Quellen, aus denen e-bambino.com seine Inhalte prüft — von AWMF bis Destatis und BFS."
>
  <section class="bg-warm-wash">
    <div class="shell py-16 sm:py-20">
      <p class="eyebrow rise">
        <span class="inline-block h-px w-8 bg-blush" aria-hidden="true"></span>
        {quellen.length} Quellen
      </p>
      <h1 class="display-1 mt-5 rise rise-delay-1">Unsere Quellen</h1>
      <p class="lede measure mt-6 text-pretty rise rise-delay-2">
        Jede Zahl auf dieser Website stammt aus einer der folgenden Quellen. Alles andere streichen wir.
      </p>
    </div>
  </section>

  <section class="shell py-16 sm:py-20">
    <ul class="divide-y divide-mist-200 border-y border-mist-200">
      {
        quellen.map((q) => (
          <li>
            <div class="flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
              <div>
                <a
                  href={q.url}
                  rel="noopener noreferrer external"
                  target="_blank"
                  class="font-display text-xl font-semibold text-ink transition-colors duration-300 hover:text-plum"
                >
                  {q.org}
                </a>
                <p class="mt-1 text-sm text-mist-500">{q.voll}</p>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-mist-600">
                  <span class="font-medium text-ink">Wofür:</span> {q.fuer}
                </p>
              </div>
              <span class="shrink-0 text-sm text-blush" aria-hidden="true">
                ↗
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <aside class="mt-14 rounded-card border border-mist-200 bg-sand-50 p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Was wir nicht als Quelle nutzen</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-700">
        Kein SEO-Affiliate-Netzwerk, keine unbenannten Blogs, keine Wikipedia-Abschnitte ohne Primärquelle,
        keine Zahlen aus Foren oder sozialen Medien. Wenn eine Angabe sich nicht gegen eine Primärquelle
        prüfen lässt, kommt sie nicht auf die Seite.
      </p>
    </aside>

    <p class="mt-10 text-sm text-mist-600">
      Fehlt eine Quelle oder finden Sie einen Fehler? Schreiben Sie uns an{' '}
      <a href="mailto:kontakt@e-bambino.com" class="text-plum underline decoration-blush-200 decoration-2 underline-offset-2">
        kontakt@e-bambino.com
      </a>
      .
    </p>
  </section>
</Layout>