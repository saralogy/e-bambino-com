---
import CollectionDetail from '../../views/CollectionDetail.astro';
import { getCollection } from 'astro:content';
import { entryLang, entrySlug } from '../../i18n';

export async function getStaticPaths() {
  return (await getCollection('checklisten'))
    .filter((entry) => entryLang(entry) === 'en')
    .map((entry) => ({ params: { slug: entrySlug(entry) }, props: { entry } }));
}
---

<CollectionDetail lang="en" collection="checklisten" entry={Astro.props.entry} />
