---
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { TAXONOMY, QUESTION_TYPES } from '../../data/taxonomie';
import { shipGate } from '../../lib/shipgate';

export async function getStaticPaths() {
  const entries = await getCollection('fragen');
  // Build-time publication gate: a YMYL page without a named human reviewer
  // must never reach dist/. It is held, not published-with-a-warning.
  return entries
    .filter((entry) => shipGate(entry.data).ship)
    .map((entry) => ({ params: { hub: entry.data.hub, slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'fragen'> };
const { Content } = await render(entry);

const hub = TAXONOMY.find((h) => h.slug === entry.data.hub);
const siblings = (await getCollection('fragen', (e) => e.data.hub === entry.data.hub))
  .filter((e) => e.slug !== entry.data.slug && shipGate(e.data).ship)
  .slice(0, 5);

const typLabel = QUESTION_TYPES[entry.data.frageTyp]?.label ?? entry.data.frageTyp;
const dtf = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });

// FAQPage schema — visible FAQ on the page, which is the only legitimate use.
const faqItems = entry.data.ymyl ? [] : [];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: entry.data.frage,
      description: entry.data.description,
      datePublished: entry.data.date.toISOString(),
      dateModified: (entry.data.updatedDate ?? entry.data.date).toISOString(),
      inLanguage: 'de',
      author: { '@type': 'Organization', name: entry.data.author },
      publisher: {
        '@type': 'Organization',
        name: 'e-bambino',
        url: 'https://e-bambino.com',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://e-bambino.com/' },
        { '@type': 'ListItem', position: 2, name: hub?.label ?? entry.data.hub, item: `https://e-bambino.com/${entry.data.hub}/` },
        { '@type': 'ListItem', position: 3, name: entry.data.frage, item: Astro.url.href },
      ],
    },
  ],
});
---

<Layout title={entry.data.title} description={entry.data.description} type="article">
  <script type="application/ld+json" set:html={jsonLd} />

  <article class="shell measure py-12 sm:py-16">
    <nav class="mb-8 flex items-center gap-2 text-sm text-mist-500" aria-label="Brotkrumen">
      <a href="/" class="transition-colors hover:text-plum">Start</a>
      <span aria-hidden="true">/</span>
      <a href={`/${entry.data.hub}/`} class="transition-colors hover:text-plum">
        {hub?.label ?? entry.data.hub}
      </a>
    </nav>

    <header class="mb-9">
      <h1 class="display-2 text-balance">{entry.data.frage}</h1>
      <dl class="mt-6 flex flex-wrap items-center gap-2">
        <div>
          <dt class="sr-only">Fragetyp</dt>
          <dd class="chip-blush">{typLabel}</dd>
        </div>
        <div>
          <dt class="sr-only">Stand</dt>
          <dd class="chip-mist">
            <time datetime={(entry.data.updatedDate ?? entry.data.date).toISOString()}>
              Stand {dtf.format(entry.data.updatedDate ?? entry.data.date)}
            </time>
          </dd>
        </div>
      </dl>
    </header>

    {/* Answer-first block — 40–60 words, the AI-snippet target */}
    <div class="mb-10 rounded-card border border-blush-200 bg-blush-50 p-6 sm:p-7">
      <p class="text-pretty text-lg leading-relaxed text-ink">{entry.data.antwort}</p>
    </div>

    {/* Trust box */}
    <aside class="mb-12 rounded-card border border-mist-200 bg-sand-50 p-6 text-sm">
      <dl class="grid gap-x-10 gap-y-3 sm:grid-cols-2">
        <div class="flex gap-2">
          <dt class="font-semibold text-ink">Autor:</dt>
          <dd class="text-mist-600">{entry.data.author}</dd>
        </div>
        {entry.data.ymyl && entry.data.reviewedBy && (
          <div class="flex gap-2">
            <dt class="font-semibold text-ink">Medizinisch geprüft:</dt>
            <dd class="text-mist-600">{entry.data.reviewedBy}</dd>
          </div>
        )}
        <div class="flex gap-2">
          <dt class="font-semibold text-ink">Aktualisiert am:</dt>
          <dd class="text-mist-600">{dtf.format(entry.data.updatedDate ?? entry.data.date)}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="font-semibold text-ink">Quellen:</dt>
          <dd class="text-mist-600">
            {entry.data.quellen.length ? (
              entry.data.quellen.join(', ')
            ) : (
              <a href="/quellen/" class="text-plum underline underline-offset-2">siehe Quellen</a>
            )}
          </dd>
        </div>
      </dl>
      <p class="mt-5 border-t border-mist-200 pt-4 text-xs leading-relaxed text-mist-600">
        Von Menschen erstellt und geprüft — menschliche Prüfung, Quellen offengelegt (EU AI Act Art. 50).
        Keine medizinische Beratung.
      </p>
    </aside>

    <div class="prose">
      <Content />
    </div>

    {/* Siblings */}
    {
      siblings.length > 0 && (
        <section class="mt-16 pt-10 border-t border-mist-200">
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-mist-500">
            Weitere Fragen zu {hub?.label ?? entry.data.hub}
          </h2>
          <ul class="mt-5 divide-y divide-mist-200 border-y border-mist-200">
            {siblings.map((s) => (
              <li>
                <a
                  href={`/${s.data.hub}/${s.data.slug}/`}
                  class="group flex items-center justify-between gap-6 py-4 transition-colors duration-300"
                >
                  <span class="font-medium text-ink transition-colors duration-300 group-hover:text-plum">
                    {s.data.frage}
                  </span>
                  <span class="shrink-0 text-blush transition-transform duration-300 ease-smooth group-hover:translate-x-1" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Layout>