---
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { TAXONOMY, QUESTION_TYPES } from '../../data/taxonomie';
import { shipGate } from '../../lib/shipgate';

export async function getStaticPaths() {
  const entries = await getCollection('fragen');
  // Build-time publication gate: a YMYL page without a named human reviewer
  // must never reach dist/. It is held, not published-with-a-warning.
  return entries
    .filter((entry) => shipGate(entry.data).ship)
    .map((entry) => ({ params: { hub: entry.data.hub, slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'fragen'> };
const { Content } = await render(entry);

const hub = TAXONOMY.find((h) => h.slug === entry.data.hub);
const siblings = (await getCollection('fragen', (e) => e.data.hub === entry.data.hub))
  .filter((e) => e.slug !== entry.data.slug && shipGate(e.data).ship)
  .slice(0, 5);

const typLabel = QUESTION_TYPES[entry.data.frageTyp]?.label ?? entry.data.frageTyp;
const dtf = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });

// FAQPage schema — visible FAQ on the page, which is the only legitimate use.
const faqItems = entry.data.ymyl ? [] : [];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: entry.data.frage,
      description: entry.data.description,
      datePublished: entry.data.date.toISOString(),
      dateModified: (entry.data.updatedDate ?? entry.data.date).toISOString(),
      inLanguage: 'de',
      author: { '@type': 'Organization', name: entry.data.author },
      publisher: {
        '@type': 'Organization',
        name: 'e-bambino',
        url: 'https://e-bambino.com',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://e-bambino.com/' },
        { '@type': 'ListItem', position: 2, name: hub?.label ?? entry.data.hub, item: `https://e-bambino.com/${entry.data.hub}/` },
        { '@type': 'ListItem', position: 3, name: entry.data.frage, item: Astro.url.href },
      ],
    },
  ],
});
---

<Layout title={entry.data.title} description={entry.data.description} type="article">
  <script type="application/ld+json" set:html={jsonLd} />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-gray-500 mb-6" aria-label="Brotkrumen">
      <a href="/" class="hover:text-primary-600">Start</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <a href={`/${entry.data.hub}/`} class="hover:text-primary-600">{hub?.label ?? entry.data.hub}</a>
    </nav>

    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">{entry.data.frage}</h1>
      <dl class="mt-5 flex flex-wrap gap-2 text-xs">
        <div><dt class="sr-only">Fragetyp</dt><dd class="rounded-full bg-primary-100 text-primary-800 px-3 py-1">{typLabel}</dd></div>
        <div><dt class="sr-only">Stand</dt><dd class="rounded-full bg-gray-100 text-gray-500 px-3 py-1">Stand {dtf.format(entry.data.updatedDate ?? entry.data.date)}</dd></div>
        {entry.data.ymyl && (
          <div><dt class="sr-only">Medizinisch geprüft</dt><dd class="rounded-full bg-amber-100 text-amber-800 px-3 py-1">Medizinisch geprüft</dd></div>
        )}
      </dl>
    </header>

    {/* Answer-first block — 40–60 words, the AI-snippet target */}
    <div class="rounded-xl border-l-4 border-primary-500 bg-primary-50/60 p-6 mb-10">
      <p class="text-lg leading-relaxed text-gray-800">{entry.data.antwort}</p>
    </div>

    {/* Trust box */}
    <aside class="mb-10 rounded-xl border border-gray-200 bg-gray-50 p-5 text-sm">
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2">
        <div class="flex gap-2"><dt class="font-medium text-gray-700">Autor:</dt><dd class="text-gray-600">{entry.data.author}</dd></div>
        {entry.data.ymyl && entry.data.reviewedBy && (
          <div class="flex gap-2"><dt class="font-medium text-gray-700">Medizinisch geprüft:</dt><dd class="text-gray-600">{entry.data.reviewedBy}</dd></div>
        )}
        <div class="flex gap-2"><dt class="font-medium text-gray-700">Aktualisiert am:</dt><dd class="text-gray-600">{dtf.format(entry.data.updatedDate ?? entry.data.date)}</dd></div>
        <div class="flex gap-2">
          <dt class="font-medium text-gray-700">Quellen:</dt>
          <dd class="text-gray-600">
            {entry.data.quellen.length ? entry.data.quellen.join(', ') : 'siehe <a href="/quellen/" class="text-primary-600 underline underline-offset-2">Quellen</a>'}
          </dd>
        </div>
      </dl>
      <p class="mt-3 pt-3 border-t border-gray-200 text-xs text-gray-500">
        Von Menschen erstellt und geprüft — menschliche Prüfung, Quellen offengelegt (EU AI Act Art. 50).
        Keine medizinische Beratung.
      </p>
    </aside>

    <div class="prose">
      <Content />
    </div>

    {/* Siblings */}
    {siblings.length > 0 && (
      <section class="mt-14 pt-8 border-t border-gray-200">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mb-4">
          Weitere Fragen zu {hub?.label ?? entry.data.hub}
        </h2>
        <ul class="space-y-2">
          {siblings.map((s) => (
            <li>
              <a href={`/${s.data.hub}/${s.data.slug}/`} class="text-primary-700 hover:text-primary-800 hover:underline underline-offset-2">
                {s.data.frage}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Layout>