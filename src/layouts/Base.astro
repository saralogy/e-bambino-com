---
// Base.astro — single root layout for the whole site.
// All other layouts/pages compose on top of this.
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title,
  description = 'e-bambino.com — der italienische Familienratgeber für DACH & EU. Baby-Namen, Checklisten, finanzielle Hilfen und Ratgeber. Von Menschen geprüft.',
  image,
  canonical,
  type = 'website',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      Self-hosted fonts. Deliberately NOT the Google CDN: loading fonts from
      fonts.googleapis.com sends the visitor's IP to a US server, which German
      courts have treated as a GDPR violation absent consent. Files live in
      public/fonts and are served from e-bambino.com.
      Fraunces = variable optical-size serif (display).
      Karla = humanist grotesque (body/UI).
    */}
    <link rel="preconnect" href="/" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/karla-v33-qkBbXvYC6trAT7RbLtyU5rZPoAU.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <SEO {title} {description} {image} {canonical} {type} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded-pill focus:bg-ink focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white"
      >Zum Inhalt springen</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>