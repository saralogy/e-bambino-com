---
// Base.astro — single root layout for the whole site.
// All other layouts/pages compose on top of this.
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { UI, type Lang } from '../i18n';
import '../styles/global.css';

export interface Props {
  lang?: Lang;
  /** Paths of this page in each language, for hreflang and the language switch. */
  alternates?: Partial<Record<Lang, string>>;
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { lang = 'en', alternates = {}, title, description, image, canonical, type = 'website', noindex = false } = Astro.props;
const t = UI[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      Self-hosted fonts. Deliberately NOT the Google CDN: loading fonts from
      fonts.googleapis.com sends the visitor's IP to a US server, which German
      courts have treated as a GDPR violation absent consent. Files live in
      public/fonts and are served from e-bambino.com.
      Bricolage Grotesque = variable display face (headlines, prices).
      Hanken Grotesk = humanist grotesque (body/UI).
    */}
    <link rel="preconnect" href="/" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/hanken-grotesk-latin.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <SEO {lang} {alternates} {title} description={description ?? t.siteDescription} {image} {canonical} {type} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded-pill focus:bg-night focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white"
      >{t.skip}</a
    >
    <Header {lang} {alternates} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer {lang} />
  </body>
</html>
