---
// ContentPage.astro — layout for Markdown pages declared via `layout:` frontmatter.
// Renders the Markdown body inside the site shell with the shared prose typography.
import Base from './Base.astro';
import type { Props } from './Base.astro';

const props = Astro.props as Props;
---

<Base {...props}>
  <article class="shell measure py-12 sm:py-16">
    <slot />
  </article>
</Base>