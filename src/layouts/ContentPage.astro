---
// ContentPage.astro — layout for Markdown pages declared via `layout:` frontmatter.
import Base from './Base.astro';
import type { Props } from './Base.astro';

const props = Astro.props as Props;
---

<Base {...props}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <slot />
  </article>
</Base>