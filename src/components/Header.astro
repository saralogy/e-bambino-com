---
// Header.astro — sticky site header with primary nav + language switch
const navItems = [
  { label: 'Fragen', href: '/fragen/' },
  { label: 'Namen', href: '/namen/' },
  { label: 'Checklisten', href: '/checklisten/' },
  { label: 'Finanzielle Hilfen', href: '/finanz/' },
  { label: 'Ratgeber', href: '/ratgeber/' },
  { label: 'Über uns', href: '/ueber-uns/' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-fog-100 bg-paper/85 backdrop-blur-md">
  <div class="shell">
    <div class="flex h-[4.25rem] items-center justify-between gap-4">
      <a href="/" class="group flex items-center gap-2.5" aria-label="e-bambino Startseite">
        <svg width="34" height="34" viewBox="0 0 48 48" aria-hidden="true">
          <rect x="7" y="3" width="11" height="42" rx="5.5" fill="#2438F5"></rect>
          <circle cx="29" cy="30" r="12" fill="none" stroke="#2438F5" stroke-width="10"></circle>
          <circle cx="37" cy="9" r="5.5" fill="#FF6A1A"></circle>
        </svg>
        <span class="font-display text-[1.5rem] font-extrabold tracking-tight text-night">
          e<span class="text-mandarin">-</span>bambino
        </span>
      </a>

      <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Hauptnavigation">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative rounded-pill px-3.5 py-2.5 text-[0.9375rem] font-semibold transition-colors duration-300',
                isActive(item.href) ? 'text-ultramarine' : 'text-night-700 hover:text-ultramarine',
              ]}
            >
              {item.label}
              {isActive(item.href) && (
                <span
                  class="absolute inset-x-3.5 -bottom-0.5 h-[3px] rounded-full bg-ultramarine"
                  aria-hidden="true"
                />
              )}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <div
          class="hidden items-center gap-0.5 rounded-pill bg-fog p-0.5 text-xs font-semibold lg:flex"
          aria-label="Sprache wählen"
        >
          <span class="rounded-pill bg-white px-2.5 py-1 text-night shadow-soft">DE</span>
          <span class="px-2.5 py-1 text-night-500" title="Italienische Version folgt">IT</span>
        </div>

        <button
          id="menu-btn"
          type="button"
          class="lg:hidden -mr-2 inline-flex min-h-tap-s min-w-tap items-center justify-center rounded-lg p-2 text-night transition-colors hover:bg-fog"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menü öffnen"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-fog-100 bg-paper lg:hidden"
    role="dialog"
    aria-label="Mobile Navigation"
  >
    <nav class="shell py-4 space-y-1" aria-label="Mobile Navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block rounded-lg px-3 py-3 text-base font-medium transition-colors',
              isActive(item.href) ? 'bg-ultramarine-50 text-ultramarine-700' : 'text-night-700 hover:bg-fog',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <div class="flex items-center gap-2 px-3 pt-3 text-xs font-semibold text-night-500">
        <span class="rounded-pill bg-night px-2.5 py-1 text-white">DE</span>
        <span class="px-2.5 py-1 text-night-500">IT (bald)</span>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
  });
</script>