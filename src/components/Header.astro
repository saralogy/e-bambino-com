---
// Header.astro — notice bar, sticky site header with primary nav and the EN/DE language switch.
import { UI, LANGS, path, sectionPath, type Lang } from '../i18n';

export interface Props {
  lang: Lang;
  alternates?: Partial<Record<Lang, string>>;
}

const { lang, alternates = {} } = Astro.props;
const t = UI[lang];

const navItems = [
  { label: t.nav.questions, href: sectionPath(lang, 'questions') },
  { label: t.nav.names, href: sectionPath(lang, 'names') },
  { label: t.nav.checklists, href: sectionPath(lang, 'checklists') },
  lang === 'de' ? { label: UI.de.nav.finance, href: sectionPath('de', 'finance') } : null,
  { label: t.nav.guides, href: sectionPath(lang, 'guides') },
  { label: t.nav.about, href: sectionPath(lang, 'about') },
].filter((i): i is { label: string; href: string } => Boolean(i && i.href));

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(href);

// Language switch: go to this page's translation when there is one, else to that language's home.
const langLinks = LANGS.map((l) => ({ lang: l, href: alternates[l] ?? path(l), current: l === lang }));
---

<div class="bg-night text-white">
  <p class="shell py-2 text-center text-[0.8125rem] font-semibold">
    {t.notice[0]} <span class="mx-1.5 text-limone" aria-hidden="true">·</span> {t.notice[1]}
    <span class="hidden sm:inline"><span class="mx-1.5 text-limone" aria-hidden="true">·</span> {t.notice[2]}</span>
  </p>
</div>

<header class="sticky top-0 z-50 border-b border-fog-100 bg-paper/85 backdrop-blur-md">
  <div class="shell">
    <div class="flex h-[4.25rem] items-center justify-between gap-4">
      <a href={path(lang)} class="group flex min-h-tap-s items-center gap-2.5" aria-label={t.homeLabel}>
        <svg width="34" height="34" viewBox="0 0 48 48" aria-hidden="true">
          <rect x="7" y="3" width="11" height="42" rx="5.5" fill="#2438F5"></rect>
          <circle cx="29" cy="30" r="12" fill="none" stroke="#2438F5" stroke-width="10"></circle>
          <circle cx="37" cy="9" r="5.5" fill="#FF6A1A"></circle>
        </svg>
        <span class="font-display text-[1.5rem] font-extrabold tracking-tight text-night">
          e<span class="text-mandarin">-</span>bambino
        </span>
      </a>

      <nav class="hidden items-center gap-0.5 lg:flex" aria-label={t.mainNav}>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative inline-flex min-h-tap-s items-center rounded-pill px-3.5 text-[0.9375rem] font-semibold transition-colors duration-300',
                isActive(item.href) ? 'text-ultramarine' : 'text-night-700 hover:text-ultramarine',
              ]}
            >
              {item.label}
              {isActive(item.href) && (
                <span class="absolute inset-x-3.5 -bottom-0.5 h-[3px] rounded-full bg-ultramarine" aria-hidden="true" />
              )}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <nav class="hidden items-center gap-0.5 rounded-pill bg-fog p-1 text-xs font-bold sm:flex" aria-label={t.langSwitch}>
          {
            langLinks.map((l) =>
              l.current ? (
                <span class="inline-flex min-h-tap-s min-w-tap items-center justify-center rounded-pill bg-white px-2.5 text-night shadow-soft" aria-current="true">
                  {l.lang.toUpperCase()}
                </span>
              ) : (
                <a
                  href={l.href}
                  hreflang={l.lang}
                  lang={l.lang}
                  class="inline-flex min-h-tap-s min-w-tap items-center justify-center rounded-pill px-2.5 text-night-700 transition-colors hover:text-ultramarine"
                >
                  {l.lang.toUpperCase()}
                </a>
              ),
            )
          }
        </nav>

        <button
          id="menu-btn"
          type="button"
          class="lg:hidden -mr-2 inline-flex min-h-tap-s min-w-tap items-center justify-center rounded-lg p-2 text-night transition-colors hover:bg-fog"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t.menuOpen}
          data-open-label={t.menuOpen}
          data-close-label={t.menuClose}
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-fog-100 bg-paper lg:hidden">
    <nav class="shell py-4 space-y-1" aria-label={t.mainNav}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block rounded-lg px-3 py-3 text-base font-medium transition-colors',
              isActive(item.href) ? 'bg-ultramarine-50 text-ultramarine-700' : 'text-night-700 hover:bg-fog',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <div class="flex gap-2 px-3 pt-3 text-sm font-bold" aria-label={t.langSwitch}>
        {
          langLinks.map((l) =>
            l.current ? (
              <span class="inline-flex min-h-tap-s min-w-tap items-center justify-center rounded-pill bg-night px-3 text-white" aria-current="true">{l.lang.toUpperCase()}</span>
            ) : (
              <a href={l.href} hreflang={l.lang} lang={l.lang} class="inline-flex min-h-tap-s min-w-tap items-center justify-center rounded-pill bg-fog px-3 text-night">{l.lang.toUpperCase()}</a>
            ),
          )
        }
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', (open ? btn.dataset.closeLabel : btn.dataset.openLabel) ?? '');
  });
</script>
