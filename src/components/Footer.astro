---
// Footer.astro — dark brand footer with gradient, categories, legal and the AI Act note
const year = new Date().getFullYear();

const kategorien = [
  { label: 'Fragen & Antworten', href: '/fragen/' },
  { label: 'Baby-Namen', href: '/namen/' },
  { label: 'Checklisten', href: '/checklisten/' },
  { label: 'Finanzielle Hilfen', href: '/finanz/' },
  { label: 'Ratgeber', href: '/ratgeber/' },
];

const rechtliches = [
  { label: 'Impressum', href: '/impressum/' },
  { label: 'Datenschutz', href: '/datenschutz/' },
  { label: 'Quellen', href: '/quellen/' },
];
---

<footer class="mt-auto bg-deep text-white">
  <div class="shell py-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <p class="font-display text-2xl font-extrabold tracking-tight">
          e<span class="text-mandarin">-</span>bambino<span class="text-limone">.</span>com
        </p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-fog-300">
          Der italienische Familienratgeber für DACH und die EU. Namen, Checklisten und finanzielle
          Hilfen — verständlich, geprüft, auf Deutsch.
        </p>
        <div class="rule-gradient mt-8 w-24" aria-hidden="true"></div>
      </div>

      <div class="lg:col-span-3">
        <h2 class="text-xs font-bold uppercase tracking-[0.08em] text-limone">Bereiche</h2>
        <ul class="mt-4 space-y-0.5">
          {
            kategorien.map((k) => (
              <li>
                <a
                  href={k.href}
                  class="inline-flex min-h-tap-s items-center text-sm text-fog-100 transition-colors duration-300 hover:text-limone"
                >
                  {k.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h2 class="text-xs font-bold uppercase tracking-[0.08em] text-limone">Rechtliches</h2>
        <ul class="mt-4 space-y-0.5">
          {
            rechtliches.map((k) => (
              <li>
                <a
                  href={k.href}
                  class="inline-flex min-h-tap-s items-center text-sm text-fog-100 transition-colors duration-300 hover:text-limone"
                >
                  {k.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h2 class="text-xs font-bold uppercase tracking-[0.08em] text-limone">Kontakt</h2>
        <ul class="mt-4 space-y-0.5 text-sm">
          <li>
            <a
              href="mailto:kontakt@e-bambino.com"
              class="inline-flex min-h-tap-s items-center text-fog-100 transition-colors duration-300 hover:text-limone"
            >
              kontakt@e-bambino.com
            </a>
          </li>
          <li>
            <a
              href="/ueber-uns/"
              class="inline-flex min-h-tap-s items-center text-fog-100 transition-colors duration-300 hover:text-limone"
            >
              Redaktion &amp; Arbeitsweise
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 border-t border-white/10 pt-8 space-y-2 text-center">
      <p class="text-sm text-fog-300">© {year} e-bambino.com. Alle Rechte vorbehalten.</p>
      <p class="mx-auto max-w-2xl text-xs leading-relaxed text-fog-300">
        Inhalte von menschlichen Redakteuren erstellt und geprüft — im Einklang mit EU AI Act Art. 50.
        Keine medizinische Beratung.
      </p>
    </div>
  </div>
</footer>