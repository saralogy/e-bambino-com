---
// Breadcrumbs.astro — consistent editorial breadcrumb trail.
export interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="mb-4 flex flex-wrap items-center gap-x-2 text-sm text-night-500" aria-label="Brotkrumen">
  {
    items.map((item, i) => (
      <>
        {i > 0 && <span aria-hidden="true">/</span>}
        {item.href ? (
          <a href={item.href} class="inline-flex min-h-tap-s items-center transition-colors hover:text-ultramarine-700">
            {item.label}
          </a>
        ) : (
          <span class="text-white">{item.label}</span>
        )}
      </>
    ))
  }
</nav>