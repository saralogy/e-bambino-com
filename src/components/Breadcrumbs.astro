---
// Breadcrumbs.astro — consistent editorial breadcrumb trail.
export interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="mb-8 flex flex-wrap items-center gap-2 text-sm text-mist-500" aria-label="Brotkrumen">
  {
    items.map((item, i) => (
      <>
        {i > 0 && <span aria-hidden="true">/</span>}
        {item.href ? (
          <a href={item.href} class="transition-colors hover:text-plum">
            {item.label}
          </a>
        ) : (
          <span class="text-ink">{item.label}</span>
        )}
      </>
    ))
  }
</nav>