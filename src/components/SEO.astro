---
// SEO.astro — meta tags, hreflang alternates, Open Graph, Twitter card, JSON-LD.
import { SITE, UI, type Lang } from '../i18n';

export interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
  title?: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
}

const {
  lang,
  alternates,
  title,
  description,
  image = `${SITE}/og-default.png`,
  canonical = Astro.url.href,
  type = 'website',
} = Astro.props;

const t = UI[lang];
const fullTitle = title ? `${title} | e-bambino` : t.siteTitle;

// hreflang: every language version of this page, plus x-default → English.
const alts = Object.entries(alternates).filter(([, p]) => p) as [Lang, string][];
const xDefault = alternates.en;

// JSON-LD must be serialised with set:html — a bare object literal is not valid there.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebSite',
  name: fullTitle,
  description,
  url: canonical,
  inLanguage: lang,
  publisher: {
    '@type': 'Organization',
    name: 'e-bambino',
    url: SITE,
    logo: { '@type': 'ImageObject', url: `${SITE}/logo.png` },
  },
});
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alts.length > 1 && alts.map(([l, p]) => <link rel="alternate" hreflang={l} href={`${SITE}${p}`} />)}
{alts.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={`${SITE}${xDefault}`} />}

<meta property="og:site_name" content="e-bambino" />
<meta property="og:type" content={type} />
<meta property="og:locale" content={t.ogLocale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<script type="application/ld+json" set:html={jsonLd} />
